@using ContentRating.Web.UI.ViewModels
@using ContentRating.Domain.Shared.Content
@using MudBlazor
@implements IDisposable

<div style="margin-bottom: 12px;">
    <MudCard Elevation="2">
        <MudCardContent>
            @if (ContentItem.IsEditing)
            {
                <!-- Режим редактирования -->
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="ContentItem.Name"
                                     Label="Название"
                                     Required="true"
                                     MaxLength="300" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="ContentItem.Url"
                                     Label="URL"
                                     Required="true" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudSelect @bind-Value="ContentItem.ContentType" Label="Тип">
                            <MudSelectItem T="ContentType" Value="@ContentType.Video">Видео</MudSelectItem>
                            <MudSelectItem T="ContentType" Value="@ContentType.Audio">Аудио</MudSelectItem>
                            <MudSelectItem T="ContentType" Value="@ContentType.Image">Изображение</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudGrid>
                            <MudItem xs="6">
                                <MudIconButton Icon="@Icons.Material.Filled.Save"
                                              Color="Color.Success"
                                              OnClick="OnSaveClick"
                                              Size="Size.Small" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                              Color="Color.Secondary"
                                              OnClick="OnCancelClick"
                                              Size="Size.Small" />
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                </MudGrid>
            }
            else
            {
                <!-- Режим просмотра -->
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <!-- Предварительный просмотр контента -->
                        <ContentRating.Web.UI.Components.ContentPreviewComponent 
                            ContentItem="ContentItem"
                            Width="100%"
                            MaxHeight="250px"
                            ShowContentInfo="false"
                            ShowMetadata="false"
                            RoundedCorners="true"
                            Elevation="1"
                            ImageObjectFit="ObjectFit.Contain"
                            AutoLoadVideos="false" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.h6" GutterBottom="true">
                            @ContentItem.Name
                        </MudText>
                        <MudLink Href="@ContentItem.Url" Target="_blank" Typo="Typo.body2">
                            @ContentItem.Url
                        </MudLink>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                            @ContentItem.LastModificationDate.ToString("dd.MM.yyyy HH:mm")
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudChip T="string" 
                                Color="@GetContentTypeColor(ContentItem.ContentType)" 
                                Icon="@GetContentTypeIcon(ContentItem.ContentType)"
                                Size="Size.Small">
                            @ContentItem.ContentTypeDisplayName
                        </MudChip>
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudGrid>
                            <MudItem xs="6">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                              Color="Color.Primary"
                                              OnClick="OnEditClick"
                                              Size="Size.Small" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                              Color="Color.Error"
                                              OnClick="OnDeleteClick"
                                              Size="Size.Small" />
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                </MudGrid>
            }
        </MudCardContent>
    </MudCard>
</div>

@code {
    [Parameter] public ContentItemViewModel ContentItem { get; set; } = null!;
    [Parameter] public EventCallback<ContentItemViewModel> OnEdit { get; set; }
    [Parameter] public EventCallback<ContentItemViewModel> OnSave { get; set; }
    [Parameter] public EventCallback<ContentItemViewModel> OnCancel { get; set; }
    [Parameter] public EventCallback<ContentItemViewModel> OnDelete { get; set; }
    
    private bool _lastEditingState = false;

    protected override bool ShouldRender()
    {
        // Перерисовываем только если изменилось состояние редактирования или данные элемента
        var shouldRender = ContentItem.IsEditing != _lastEditingState || 
                          ContentItem.Name != _lastContentName ||
                          ContentItem.Url != _lastContentUrl;
        
        _lastEditingState = ContentItem.IsEditing;
        _lastContentName = ContentItem.Name;
        _lastContentUrl = ContentItem.Url;
        
        return shouldRender;
    }

    private string _lastContentName = string.Empty;
    private string _lastContentUrl = string.Empty;

    private async Task OnEditClick()
    {
        await OnEdit.InvokeAsync(ContentItem);
    }

    private async Task OnSaveClick()
    {
        await OnSave.InvokeAsync(ContentItem);
    }

    private async Task OnCancelClick()
    {
        await OnCancel.InvokeAsync(ContentItem);
    }

    private async Task OnDeleteClick()
    {
        await OnDelete.InvokeAsync(ContentItem);
    }

    private Color GetContentTypeColor(ContentType contentType) => contentType switch
    {
        ContentType.Video => Color.Primary,
        ContentType.Audio => Color.Secondary,
        ContentType.Image => Color.Tertiary,
        _ => Color.Default
    };

    private string GetContentTypeIcon(ContentType contentType) => contentType switch
    {
        ContentType.Video => Icons.Material.Filled.VideoLibrary,
        ContentType.Audio => Icons.Material.Filled.AudioFile,
        ContentType.Image => Icons.Material.Filled.Image,
        _ => Icons.Material.Filled.QuestionMark
    };

    public void Dispose()
    {
        // Освобождение ресурсов, если необходимо
    }
} 