@using ContentRating.Web.Contracts.ContentPartyEstimationRoom
@using MudBlazor

<MudCard Class="@($"mb-3 {Class}")" Elevation="Elevation">
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.h6" GutterBottom="true">
                    @Room.RoomName
                </MudText>
                <MudGrid>
                    <MudItem>
                        <MudChip T="string"
                                Color="Color.Info" 
                                Size="Size.Small" 
                                Icon="@Icons.Material.Filled.Movie">
                            @Room.ContentCount контента
                        </MudChip>
                    </MudItem>
                    <MudItem>
                        <MudChip T="string"
                                Color="Color.Primary" 
                                Size="Size.Small" 
                                Icon="@Icons.Material.Filled.Group">
                            @Room.RatersCount оценщиков
                        </MudChip>
                    </MudItem>
                    <MudItem>
                        <MudChip T="string"
                                Color="Color.Secondary" 
                                Size="Size.Small" 
                                Icon="@Icons.Material.Filled.Person">
                            @Room.RoomCreatorName
                        </MudChip>
                    </MudItem>
                    <MudItem>
                        <MudChip T="string"
                                Color="@(Room.IsEstimated ? Color.Success : Color.Warning)" 
                                Size="Size.Small" 
                                Icon="@(Room.IsEstimated ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.AccessTime)">
                            @(Room.IsEstimated ? "Завершен" : "В процессе")
                        </MudChip>
                    </MudItem>
                </MudGrid>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudGrid Justify="Justify.FlexEnd">
                    <MudItem>
                        <MudButton Variant="Variant.Filled" 
                                 Color="Color.Primary" 
                                 StartIcon="@Icons.Material.Filled.PlayArrow"
                                 OnClick="HandleJoinClick"
                                 Disabled="IsLoading">
                            @if (IsLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            }
                            else
                            {
                                <text>Присоединиться</text>
                            }
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired] public PartyEstimationTitle Room { get; set; } = null!;
    [Parameter] public EventCallback<Guid> OnJoin { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public int Elevation { get; set; } = 2;

    private async Task HandleJoinClick()
    {
        if (OnJoin.HasDelegate)
        {
            await OnJoin.InvokeAsync(Room.Id);
        }
    }
} 