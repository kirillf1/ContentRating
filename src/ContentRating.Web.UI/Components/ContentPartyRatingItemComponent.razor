@using ContentRating.Web.UI.ViewModels
@using ContentRating.Domain.Shared.Content
@using ContentRating.Web.UI.Services
@using MudBlazor
@using System.Globalization
@implements IDisposable

<div style="margin-bottom: 12px;">
    <MudCard Elevation="2">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <!-- Предварительный просмотр контента -->
                    <ContentRating.Web.UI.Components.ContentPreviewComponent 
                        ContentItem="@GetContentItemForPreview()"
                        Width="100%"
                        MaxHeight="250px"
                        ShowContentInfo="false"
                        ShowMetadata="false"
                        RoundedCorners="true"
                        Elevation="1"
                        ImageObjectFit="ObjectFit.Contain"
                        AutoLoadVideos="false" />
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudText Typo="Typo.h6" GutterBottom="true">
                        @ContentRating.Name
                    </MudText>
                    <MudLink Href="@ContentRating.Address" Target="_blank" Typo="Typo.body2" Class="d-block mb-2">
                        @ContentRating.Address
                    </MudLink>
                    
                    @if (CreatorName != null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" />
                            Создатель: @CreatorName
                        </MudText>
                    }
                    
                    <!-- Отображение средней оценки -->
                    <div class="mt-3">
                        <MudText Typo="Typo.subtitle2">Средняя оценка:</MudText>
                        <MudText Typo="Typo.h6" Style="color: #FF9800;">
                            @ContentRating.AverageRating.ToString("F2") из @MaxRating.ToString("F0")
                        </MudText>
                    </div>

                    <!-- Отображение всех оценок -->
                    @if (ContentRating.Ratings.Any())
                    {
                        <div class="mt-2">
                            <MudText Typo="Typo.subtitle2">Оценки участников:</MudText>
                            @foreach (var rating in ContentRating.Ratings)
                            {
                                <div class="d-flex align-center mt-1">
                                    @{
                                        var isMockRater = rating.RaterName.StartsWith("Mock:");
                                        var displayName = isMockRater ? rating.RaterName.Substring(5) : rating.RaterName;
                                    }
                                    @if (isMockRater)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" Class="mr-1" Color="Color.Secondary" />
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" />
                                    }
                                    <MudText Typo="Typo.caption" Class="mr-2" Style="min-width: 80px;">
                                        @displayName:
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="ml-1" Style="font-weight: bold;">
                                        @rating.Rating.ToString("F2")
                                    </MudText>
                                </div>
                            }
                        </div>
                    }
                </MudItem>
                <MudItem xs="12" md="3">
                    <div class="d-flex flex-column">
                        <div class="d-flex justify-space-between align-center mb-3">
                            <MudChip T="string" 
                                    Color="@GetContentTypeColor(ContentRating.ContentType)" 
                                    Icon="@GetContentTypeIcon(ContentRating.ContentType)"
                                    Size="Size.Small">
                                @ContentRating.ContentTypeDisplayName
                            </MudChip>
                            
                            @if (CanDeleteContent)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                             Color="Color.Error"
                                             Size="Size.Small"
                                             Title="Удалить контент"
                                             OnClick="OnDeleteContentClicked" />
                            }
                        </div>

                        @if (CanRate)
                        {
                            <!-- Оценка текущего пользователя -->
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Ваша оценка:</MudText>
                            
                            <MudNumericField Value="_numericRating"
                                           ValueChanged="EventCallback.Factory.Create<double?>(this, OnNumericRatingValueChanged)"
                                           Min="@MinRating"
                                           Max="@MaxRating"
                                           Step="0.01"
                                           Variant="Variant.Outlined"
                                           Placeholder="Введите оценку (используйте точку: 7.5)"
                                           Immediate="false"       
                                           Class="mb-2"
                                           HelperText="@($"От {MinRating:F2} до {MaxRating:F2} (используйте точку как разделитель)")"
                                           Error="@_hasValidationError"
                                           ErrorText="@_validationErrorText"
                                           Format="F2"
                                           InvertMouseWheel="false"
                                           Culture="@_invariantCulture" />
                            
                            <MudText Typo="Typo.caption" Class="mt-1">
                                @if (CurrentUserRating.HasValue)
                                {
                                    <text>@CurrentUserRating.Value.ToString("F2") из @MaxRating.ToString("F0")</text>
                                }
                                else
                                {
                                    <text>Не оценено</text>
                                }
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @if (IsEstimationCompleted)
                                {
                                    <text>Оценка завершена</text>
                                }
                                else
                                {
                                    <text>Недоступно для оценки</text>
                                }
                            </MudText>
                        }
                    </div>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <!-- Управление mock пользователями -->
    @if (MockRaters.Any())
    {
        <MudExpansionPanels Class="mt-2">
            <MockRaterControlComponent MockRaters="@MockRaters" 
                                     ContentRating="@ContentRating"
                                     MinRating="@MinRating"
                                     MaxRating="@MaxRating"
                                     OnMockRatingChanged="@OnMockRatingChanged" />
        </MudExpansionPanels>
    }
</div>

@code {
    [Parameter] public ContentPartyRatingViewModel ContentRating { get; set; } = null!;
    [Parameter] public double MinRating { get; set; } = 0.0;
    [Parameter] public double MaxRating { get; set; } = 10.0;
    [Parameter] public double? CurrentUserRating { get; set; }
    [Parameter] public bool CanRate { get; set; } = false;
    [Parameter] public bool IsEstimationCompleted { get; set; } = false;
    [Parameter] public EventCallback<(Guid ContentRatingId, double Rating)> OnRatingChanged { get; set; }
    [Parameter] public IContentPartyEstimationHubService? HubService { get; set; }
    [Parameter] public IEnumerable<RaterViewModel> MockRaters { get; set; } = Enumerable.Empty<RaterViewModel>();
    [Parameter] public EventCallback<(Guid MockUserId, double Rating)> OnMockRatingChanged { get; set; }
    [Parameter] public bool CanDeleteContent { get; set; } = false;
    [Parameter] public EventCallback<Guid> OnContentDelete { get; set; }
    [Parameter] public string? CreatorName { get; set; }
    
    private double? _lastCurrentUserRating = null;
    private double _lastAverageRating = 0;
    private double _numericRating = 5.0;
    private bool _hasValidationError = false;
    private string _validationErrorText = "";
    private readonly CultureInfo _invariantCulture = CultureInfo.InvariantCulture;

    protected override void OnParametersSet()
    {
        // Если есть текущая оценка пользователя, используем её для ручного ввода
        if (CurrentUserRating.HasValue)
        {
            _numericRating = Math.Round(CurrentUserRating.Value, 2);
        }
        // Иначе используем значение по умолчанию (5.0) или минимум + половина диапазона
        else
        {
            var defaultValue = Math.Min(5.0, MaxRating);
            _numericRating = Math.Round(Math.Max(MinRating, defaultValue), 2);
        }
    }

    protected override bool ShouldRender()
    {
        // Оптимизация перерисовки - обновляем только при изменении важных параметров
        var shouldRender = CurrentUserRating != _lastCurrentUserRating ||
                          ContentRating.AverageRating != _lastAverageRating;
        
        _lastCurrentUserRating = CurrentUserRating;
        _lastAverageRating = ContentRating.AverageRating;
        
        return shouldRender;
    }

    private ContentItemViewModel GetContentItemForPreview()
    {
        return new ContentItemViewModel
        {
            Id = ContentRating.ContentId,
            Name = ContentRating.Name,
            Url = ContentRating.Address,
            ContentType = ContentRating.ContentType
        };
    }

    private async Task OnNumericRatingValueChanged(double? newValue)
    {
        _hasValidationError = false;
        _validationErrorText = "";

        if (!newValue.HasValue)
            return;

        // Округляем до 2 знаков после запятой
        var rating = Math.Round(newValue.Value, 2);
        _numericRating = rating;

        // Проверяем, что оценка в допустимых пределах
        if (rating < MinRating || rating > MaxRating)
        {
            _hasValidationError = true;
            _validationErrorText = $"Оценка должна быть от {MinRating:F2} до {MaxRating:F2}";
            StateHasChanged();
            return;
        }

        // Предпочитаем SignalR, если доступен
        if (HubService != null && HubService.IsConnected)
        {
            try
            {
                await HubService.EstimateContentAsync(ContentRating.RatingId, rating);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"SignalR error: {ex.Message}");
                // Fallback на обычный callback
                if (OnRatingChanged.HasDelegate)
                {
                    await OnRatingChanged.InvokeAsync((ContentRating.RatingId, rating));
                }
            }
        }
        else
        {
            // Fallback на обычный callback
            if (OnRatingChanged.HasDelegate)
            {
                await OnRatingChanged.InvokeAsync((ContentRating.RatingId, rating));
            }
        }
    }

    private Color GetContentTypeColor(ContentType contentType) => contentType switch
    {
        ContentType.Video => Color.Primary,
        ContentType.Audio => Color.Secondary,
        ContentType.Image => Color.Tertiary,
        _ => Color.Default
    };

    private string GetContentTypeIcon(ContentType contentType) => contentType switch
    {
        ContentType.Video => Icons.Material.Filled.VideoLibrary,
        ContentType.Audio => Icons.Material.Filled.AudioFile,
        ContentType.Image => Icons.Material.Filled.Image,
        _ => Icons.Material.Filled.QuestionMark
    };

    private async Task OnDeleteContentClicked()
    {
        if (OnContentDelete.HasDelegate)
        {
            await OnContentDelete.InvokeAsync(ContentRating.ContentId);
        }
    }



    public void Dispose()
    {
        // Освобождение ресурсов, если необходимо
    }
} 