@page "/party-estimation-rooms"
@using ContentRating.Web.Contracts.ContentPartyEstimationRoom
@using ContentRating.Web.UI.Components
@using ContentRating.Web.UI.Services
@using ContentRating.Web.UI.Services.Authentication
@using ContentRating.Web.UI.Services.Content
@using MudBlazor
@inject IContentPartyEstimationService PartyEstimationService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<ContentPartyEstimationRooms> Logger
@inject IDialogService DialogService
@inject AuthService AuthService

<PageTitle>Комнаты групповой оценки</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudGrid Justify="Justify.SpaceBetween" Class="mb-4">
        <MudItem>
            <MudText Typo="Typo.h4" GutterBottom="true">
                Комнаты групповой оценки
            </MudText>
        </MudItem>
        <MudItem>
            <MudButton Variant="Variant.Filled" 
                      Color="Color.Primary" 
                      StartIcon="@Icons.Material.Filled.Add"
                      OnClick="OpenCreateRoomDialog"
                      Disabled="isLoading">
                Создать комнату
            </MudButton>
        </MudItem>
    </MudGrid>

    <!-- Фильтры -->
    <MudGrid Class="mb-4">
        <MudItem xs="12" md="6">
            <MudCheckBox Value="showCompleted"
                        Label="Показать завершенные"
                        Color="Color.Primary"
                        T="bool"
                        ValueChanged="OnCompletedFilterChanged" />
        </MudItem>
        <MudItem xs="12" md="6">
            <MudCheckBox Value="showActive"
                        Label="Показать активные"
                        Color="Color.Primary"
                        T="bool"
                        ValueChanged="OnActiveFilterChanged" />
        </MudItem>
    </MudGrid>

    @if (isLoading)
    {
        <MudGrid Justify="Justify.Center" Class="mt-8">
            <MudItem>
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.body1" Class="mt-2" Align="Align.Center">Загружаем комнаты...</MudText>
            </MudItem>
        </MudGrid>
    }
    else if (hasError)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">
            Произошла ошибка при загрузке комнат. Попробуйте обновить страницу.
        </MudAlert>
        <MudGrid Justify="Justify.Center" Class="mt-4">
            <MudItem>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadRoomsAsync">
                    Попробовать снова
                </MudButton>
            </MudItem>
        </MudGrid>
    }
    else if (filteredRooms?.Any() != true)
    {
        <MudGrid Justify="Justify.Center" Class="mt-8">
            <MudItem xs="12" md="8" lg="6">
                <MudPaper Class="pa-6" Elevation="2">
                    <MudGrid Justify="Justify.Center">
                        <MudItem>
                            <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Large" Class="mb-3" Color="Color.Tertiary" />
                        </MudItem>
                    </MudGrid>
                    <MudText Typo="Typo.h6" Align="Align.Center" GutterBottom="true">
                        @if (rooms?.Any() == true)
                        {
                            <text>Нет комнат соответствующих фильтрам</text>
                        }
                        else
                        {
                            <text>Комнат пока нет</text>
                        }
                    </MudText>
                    <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary">
                        @if (rooms?.Any() == true)
                        {
                            <text>Измените настройки фильтров или создайте новую комнату</text>
                        }
                        else
                        {
                            <text>Создайте первую комнату для групповой оценки топов</text>
                        }
                    </MudText>
                    <MudGrid Justify="Justify.Center" Class="mt-4">
                        <MudItem>
                            <MudButton Variant="Variant.Filled" 
                                      Color="Color.Primary" 
                                      StartIcon="@Icons.Material.Filled.Add"
                                      OnClick="OpenCreateRoomDialog">
                                Создать комнату
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
    else
    {
        <MudText Typo="Typo.body1" Class="mb-4" Color="Color.Secondary">
            Найдено комнат: @filteredRooms.Count()
        </MudText>

        <MudVirtualize Items="filteredRooms.ToList()" Context="room" ItemSize="140" T="PartyEstimationTitle">
            <PartyEstimationRoomCard Room="room" 
                                                                    OnJoin="JoinRoomAsync"
                                                                    OnDelete="DeleteRoomAsync"
                                                                    IsLoading="@(joiningRoomId == room.Id)"
                                                                    IsDeleting="@(deletingRoomId == room.Id)"
                                                                    CurrentUserId="@AuthService.UserId" />
        </MudVirtualize>
    }
</MudContainer>

@code {
    private ICollection<PartyEstimationTitle>? rooms;
    private IEnumerable<PartyEstimationTitle>? filteredRooms;
    private bool isLoading = true;
    private bool hasError = false;
    private Guid? joiningRoomId = null;
    private Guid? deletingRoomId = null;
    
    private bool showCompleted = true;
    private bool showActive = true;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        await LoadRoomsAsync();
    }

    private async Task LoadRoomsAsync()
    {
        try
        {
            isLoading = true;
            hasError = false;
            StateHasChanged();

            var roomsResult = await PartyEstimationService.GetRoomsAsync(showCompleted, showActive);
            rooms = roomsResult?.ToList();
            
            if (rooms == null)
            {
                hasError = true;
                Snackbar.Add("Не удалось загрузить список комнат", Severity.Error);
            }
            else
            {
                UpdateFilteredRooms();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при загрузке списка комнат для оценки");
            hasError = true;
            Snackbar.Add("Произошла ошибка при загрузке комнат", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void UpdateFilteredRooms()
    {
        if (rooms == null)
        {
            filteredRooms = null;
            return;
        }

        filteredRooms = rooms.Where(r => 
            (showCompleted && r.IsEstimated) || 
            (showActive && !r.IsEstimated));
    }

    private async Task OnCompletedFilterChanged(bool value)
    {
        showCompleted = value;
        if (!showCompleted && !showActive)
        {
            showActive = true; // По крайней мере одна опция должна быть выбрана
        }
        
        await LoadRoomsAsync();
    }

    private async Task OnActiveFilterChanged(bool value)
    {
        showActive = value;
        if (!showCompleted && !showActive)
        {
            showCompleted = true; // По крайней мере одна опция должна быть выбрана
        }
        
        await LoadRoomsAsync();
    }

    private async Task JoinRoomAsync(Guid roomId)
    {
        try
        {
            joiningRoomId = roomId;
            StateHasChanged();

            // Находим комнату по ID
            var room = rooms?.FirstOrDefault(r => r.Id == roomId);
            
            if (room != null && room.IsEstimated)
            {
                // Если оценка завершена, переходим к результатам
                Navigation.NavigateTo($"/party-estimation/{roomId}/results");
            }
            else
            {
                // Если оценка в процессе, переходим к странице оценки
                Navigation.NavigateTo($"/party-estimation/{roomId}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при переходе к комнате {RoomId}", roomId);
            Snackbar.Add("Произошла ошибка при переходе к комнате", Severity.Error);
        }
        finally
        {
            joiningRoomId = null;
            StateHasChanged();
        }
    }

    private async Task OpenCreateRoomDialog()
    {
        var parameters = new DialogParameters<CreatePartyEstimationRoomDialog>
        {
            { x => x.OnRoomCreated, EventCallback.Factory.Create(this, LoadRoomsAsync) }
        };

        var options = new DialogOptions()
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<CreatePartyEstimationRoomDialog>(
            "Создать новую комнату", 
            parameters, 
            options);
    }

    private async Task DeleteRoomAsync(Guid roomId)
    {
        if (!AuthService.IsAuthenticated)
        {
            Snackbar.Add("Необходимо войти в систему", Severity.Warning);
            return;
        }

        var room = rooms?.FirstOrDefault(r => r.Id == roomId);
        if (room == null)
        {
            Snackbar.Add("Комната не найдена", Severity.Error);
            return;
        }

        // Подтверждение удаления
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            CloseButton = true,
            Position = DialogPosition.Center
        };

        var parameters = new DialogParameters
        {
            ["ContentText"] = $"Вы уверены, что хотите удалить комнату \"{room.RoomName}\"? Это действие нельзя отменить.",
            ["ButtonText"] = "Удалить",
            ["Color"] = Color.Error
        };

        var dialog = await DialogService.ShowAsync<MudMessageBox>("Подтверждение удаления", parameters, options);
        var result = await dialog.Result;

        if (result?.Canceled == false)
        {
            try
            {
                deletingRoomId = roomId;
                StateHasChanged();

                var success = await PartyEstimationService.DeleteRoomAsync(roomId);
                if (success)
                {
                    Snackbar.Add("Комната успешно удалена", Severity.Success);
                    await LoadRoomsAsync(); // Обновляем список
                }
                else
                {
                    Snackbar.Add("Не удалось удалить комнату", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Ошибка при удалении комнаты {RoomId}", roomId);
                Snackbar.Add("Произошла ошибка при удалении комнаты", Severity.Error);
            }
            finally
            {
                deletingRoomId = null;
                StateHasChanged();
            }
        }
    }
} 