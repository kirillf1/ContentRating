@using ContentRating.Web.UI.Services
@using Toolbelt.Blazor.PWA.Updater
@inherits LayoutComponentBase
@inject AuthService AuthService

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" 
                       Color="Color.Inherit" 
                       Edge="Edge.Start" 
                       OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6">ContentRating</MudText>
        <MudSpacer />
        <AuthComponent />
        <ThemeToggle />
      
    </MudAppBar>
    
    <MudDrawer @bind-Open="_drawerOpen" 
               Elevation="2" 
               Variant="@DrawerVariant.Responsive" 
               OpenMiniOnHover="false">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Навигация</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>
    
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<!-- PWA Updater - уведомление об обновлениях внизу экрана -->
<PWAUpdater EnvironmentsForWork="Production">
    <div class="pwa-update-notification">
        <div class="pwa-update-content">
            <MudIcon Icon="@Icons.Material.Filled.SystemUpdate" 
                     Size="Size.Medium" 
                     Class="pwa-update-icon" />
            <div class="pwa-update-text">
                <MudText Typo="Typo.body2" Class="pwa-update-title">
                    Доступна новая версия приложения
                </MudText>
                <MudText Typo="Typo.caption" Class="pwa-update-subtitle">
                    Обновите для получения новых функций и улучшений
                </MudText>
            </div>
        </div>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   Size="Size.Small"
                   Class="pwa-update-button"
                   StartIcon="@Icons.Material.Filled.Refresh">
            Обновить сейчас
        </MudButton>
    </div>
</PWAUpdater>

@code {
    bool _drawerOpen = true;

    void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await AuthService.InitializeAsync();
            }
            catch
            {
                // Игнорируем ошибки инициализации
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    protected override void OnInitialized()
    {
        // На мобильных устройствах drawer по умолчанию закрыт
        _drawerOpen = true;
    }
}
