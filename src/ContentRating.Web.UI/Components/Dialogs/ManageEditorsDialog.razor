@using ContentRating.Web.Contracts.ContentEstimationListEditor
@using ContentRating.Web.UI.Services
@using ContentRating.Web.UI.Services.Content
@using MudBlazor
@inject IContentEstimationListService ContentService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<ManageEditorsDialog> Logger

<MudDialog>
    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.Medium">
            <MudGrid AlignItems="Center" Justify="Justify.SpaceBetween" Class="mb-4">
                <MudItem>
                    <MudText Typo="Typo.h6">Редакторы топа</MudText>
                </MudItem>
                <MudItem>
                    <MudButton Variant="Variant.Filled" 
                              StartIcon="@Icons.Material.Filled.PersonAdd" 
                              Color="Color.Primary"
                              Size="Size.Medium"
                              OnClick="OpenInviteDialog">
                        Пригласить редактора
                    </MudButton>
                </MudItem>
            </MudGrid>
            
            @if (Editors.Any())
            {
                <MudGrid>
                                    @foreach (var editor in Editors.OrderBy(e => e.Name))
                {
                    <MudItem xs="12">
                        <MudCard Elevation="1" Class="pa-3">
                            <MudGrid AlignItems="Center">
                                <MudItem xs="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" />
                                </MudItem>
                                <MudItem xs="6">
                                    <MudText Typo="Typo.body1">
                                        @editor.Name
                                        @if (editor.Id == CurrentUserId)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">(Вы)</MudChip>
                                        }
                                        @if (editor.Id == CreatorId)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">(Создатель)</MudChip>
                                        }
                                    </MudText>
                                </MudItem>
                                <MudItem xs="5" Class="text-right">
                                    @if (CanKickEditor(editor))
                                    {
                                        <MudButton Variant="Variant.Outlined"
                                                  Color="Color.Error"
                                                  Size="Size.Small"
                                                  StartIcon="@Icons.Material.Filled.PersonRemove"
                                                  OnClick="() => ConfirmKickEditor(editor)"
                                                  Disabled="_isKicking">
                                            @if (_isKicking && _kickingEditorId == editor.Id)
                                            {
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                            }
                                            else
                                            {
                                                <text>Удалить</text>
                                            }
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">
                                            Нельзя удалить
                                        </MudChip>
                                    }
                                </MudItem>
                            </MudGrid>
                        </MudCard>
                    </MudItem>
                }
                </MudGrid>
            }
            else
            {
                <MudAlert Severity="Severity.Info">
                    В топе нет редакторов
                </MudAlert>
            }
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Закрыть</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public IEnumerable<InvitedEditorResponse> Editors { get; set; } = Enumerable.Empty<InvitedEditorResponse>();
    [Parameter] public Guid RoomId { get; set; }
    [Parameter] public Guid? CurrentUserId { get; set; }
    [Parameter] public Guid? CreatorId { get; set; }
    [Parameter] public EventCallback OnEditorRemoved { get; set; }
    [Parameter] public EventCallback OnEditorInvited { get; set; }

    private bool _isKicking = false;
    private Guid? _kickingEditorId = null;

    private bool CanKickEditor(InvitedEditorResponse editor)
    {
        // Проверяем, что текущий пользователь - создатель комнаты
        if (CurrentUserId != CreatorId)
            return false;

        // Нельзя удалить самого себя
        if (editor.Id == CurrentUserId)
            return false;

        // Нельзя удалить создателя
        if (editor.Id == CreatorId)
            return false;

        return true;
    }

    private async Task ConfirmKickEditor(InvitedEditorResponse editor)
    {
        var options = new DialogOptions 
        { 
            MaxWidth = MaxWidth.Small,
            CloseButton = true,
            Position = DialogPosition.Center 
        };

        var parameters = new DialogParameters
        {
            ["ContentText"] = $"Вы уверены, что хотите удалить редактора '{editor.Name}' из топа?",
            ["ButtonText"] = "Удалить",
            ["Color"] = Color.Error
        };

        var dialog = await DialogService.ShowAsync<MudMessageBox>("Подтверждение удаления", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await KickEditor(editor);
        }
    }

    private async Task KickEditor(InvitedEditorResponse editor)
    {
        _isKicking = true;
        _kickingEditorId = editor.Id;

        try
        {
            var success = await ContentService.KickEditorAsync(RoomId, editor.Id);
            
            if (success)
            {
                Snackbar.Add($"Редактор '{editor.Name}' удален из топа", Severity.Success);
                await OnEditorRemoved.InvokeAsync();
                MudDialog?.Close();
            }
            else
            {
                Snackbar.Add($"Не удалось удалить редактора '{editor.Name}'", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при удалении редактора {EditorName} из комнаты {RoomId}", editor.Name, RoomId);
            Snackbar.Add($"Ошибка при удалении редактора: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isKicking = false;
            _kickingEditorId = null;
            StateHasChanged();
        }
    }

    private async Task OpenInviteDialog()
    {
        var parameters = new DialogParameters
        {
            ["RoomId"] = RoomId,
            ["OnUserInvited"] = EventCallback.Factory.Create(this, OnEditorInvitedInternal)
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true,
            Position = DialogPosition.Center
        };

        await DialogService.ShowAsync<InviteEditorsDialog>("Пригласить редактора", parameters, options);
    }

    private async Task OnEditorInvitedInternal()
    {
        // Уведомляем родительский компонент о приглашении редактора
        await OnEditorInvited.InvokeAsync();
    }

    private void Close() => MudDialog?.Close();
} 