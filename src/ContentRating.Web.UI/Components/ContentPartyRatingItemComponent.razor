@using ContentRating.Web.UI.ViewModels
@using ContentRating.Domain.Shared.Content
@using MudBlazor
@implements IDisposable

<div style="margin-bottom: 12px;">
    <MudCard Elevation="2">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <!-- Предварительный просмотр контента -->
                    <ContentRating.Web.UI.Components.ContentPreviewComponent 
                        ContentItem="@GetContentItemForPreview()"
                        Width="100%"
                        MaxHeight="250px"
                        ShowContentInfo="false"
                        ShowMetadata="false"
                        RoundedCorners="true"
                        Elevation="1"
                        ImageObjectFit="ObjectFit.Contain"
                        AutoLoadVideos="false" />
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudText Typo="Typo.h6" GutterBottom="true">
                        @ContentRating.Name
                    </MudText>
                    <MudLink Href="@ContentRating.Address" Target="_blank" Typo="Typo.body2">
                        @ContentRating.Address
                    </MudLink>
                    
                    <!-- Отображение средней оценки -->
                    <div class="mt-3">
                        <MudText Typo="Typo.subtitle2">Средняя оценка:</MudText>
                        <MudRating ReadOnly="true" 
                                  SelectedValue="@GetAverageRatingStars()"
                                  MaxValue="@GetMaxStars()" 
                                  Size="Size.Medium"
                                  Color="Color.Warning" />
                        <MudText Typo="Typo.caption" Class="ml-2">
                            @ContentRating.AverageRating.ToString("F1") из @MaxRating
                        </MudText>
                    </div>

                    <!-- Отображение всех оценок -->
                    @if (ContentRating.Ratings.Any())
                    {
                        <div class="mt-2">
                            <MudText Typo="Typo.subtitle2">Оценки участников:</MudText>
                            @foreach (var rating in ContentRating.Ratings)
                            {
                                <div class="d-flex align-center mt-1">
                                    <MudText Typo="Typo.caption" Class="mr-2" Style="min-width: 80px;">
                                        @rating.RaterName:
                                    </MudText>
                                    <MudRating ReadOnly="true" 
                                              SelectedValue="@GetNormalizedRating(rating.Rating)"
                                              MaxValue="@GetMaxStars()" 
                                              Size="Size.Small"
                                              Color="Color.Secondary" />
                                    <MudText Typo="Typo.caption" Class="ml-1">
                                        @rating.Rating.ToString("F1")
                                    </MudText>
                                </div>
                            }
                        </div>
                    }
                </MudItem>
                <MudItem xs="12" md="3">
                    <div class="d-flex flex-column">
                        <MudChip T="string" 
                                Color="@GetContentTypeColor(ContentRating.ContentType)" 
                                Icon="@GetContentTypeIcon(ContentRating.ContentType)"
                                Size="Size.Small"
                                Class="mb-3">
                            @ContentRating.ContentTypeDisplayName
                        </MudChip>

                        @if (CanRate)
                        {
                            <!-- Оценка текущего пользователя -->
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Ваша оценка:</MudText>
                            
                            <MudRating SelectedValue="@GetCurrentUserSelectedValue()"
                                      SelectedValueChanged="OnStarRatingChanged"
                                      MaxValue="@GetMaxStars()" 
                                      Size="Size.Large"
                                      Color="Color.Primary"
                                      Disabled="@(!CanRate)" />
                            
                            <MudText Typo="Typo.caption" Class="mt-1">
                                @if (CurrentUserRating.HasValue)
                                {
                                    <text>@CurrentUserRating.Value.ToString("F1") из @MaxRating</text>
                                }
                                else
                                {
                                    <text>Не оценено</text>
                                }
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @if (IsEstimationCompleted)
                                {
                                    <text>Оценка завершена</text>
                                }
                                else
                                {
                                    <text>Недоступно для оценки</text>
                                }
                            </MudText>
                        }
                    </div>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>
</div>

@code {
    [Parameter] public ContentPartyRatingViewModel ContentRating { get; set; } = null!;
    [Parameter] public double MinRating { get; set; } = 0.0;
    [Parameter] public double MaxRating { get; set; } = 10.0;
    [Parameter] public double? CurrentUserRating { get; set; }
    [Parameter] public bool CanRate { get; set; } = false;
    [Parameter] public bool IsEstimationCompleted { get; set; } = false;
    [Parameter] public EventCallback<(Guid ContentRatingId, double Rating)> OnRatingChanged { get; set; }
    
    private double? _lastCurrentUserRating = null;
    private double _lastAverageRating = 0;

    protected override bool ShouldRender()
    {
        // Оптимизация перерисовки - обновляем только при изменении важных параметров
        var shouldRender = CurrentUserRating != _lastCurrentUserRating ||
                          ContentRating.AverageRating != _lastAverageRating;
        
        _lastCurrentUserRating = CurrentUserRating;
        _lastAverageRating = ContentRating.AverageRating;
        
        return shouldRender;
    }

    private ContentItemViewModel GetContentItemForPreview()
    {
        return new ContentItemViewModel
        {
            Id = ContentRating.ContentId,
            Name = ContentRating.Name,
            Url = ContentRating.Address,
            ContentType = ContentRating.ContentType
        };
    }

    private async Task OnStarRatingChanged(int starRating)
    {
        // Преобразуем рейтинг из звездочной системы в исходную систему
        var actualRating = ConvertFromStarRating(starRating);
        
        if (OnRatingChanged.HasDelegate)
        {
            await OnRatingChanged.InvokeAsync((ContentRating.RatingId, actualRating));
        }
    }

    private int GetCurrentUserSelectedValue()
    {
        // Если пользователь еще не поставил оценку, возвращаем 0 (без звезд)
        if (!CurrentUserRating.HasValue)
            return 0;
            
        return GetNormalizedRating(CurrentUserRating.Value);
    }

    private int GetAverageRatingStars()
    {
        // Если нет оценок, показываем 0 звезд
        if (ContentRating.AverageRating <= 0)
            return 0;
            
        return GetNormalizedRating(ContentRating.AverageRating);
    }

    private int GetMaxStars()
    {
        // Получаем максимальное количество звезд, округляя MaxRating
        return Math.Max(1, (int)Math.Round(MaxRating));
    }

    private int GetNormalizedRating(double rating)
    {
        // Преобразуем рейтинг в звездочную систему на основе MaxRating
        var maxStars = GetMaxStars();
        
        if (rating < MinRating) return 0; // Меньше минимума = 0 звезд
        if (rating >= MaxRating) return maxStars; // Максимум = maxStars звезд
        
        var range = MaxRating - MinRating;
        if (range <= 0) return 0; // Защита от деления на ноль
        
        // Если MinRating = 0, то рейтинг 0 должен давать 0 звезд
        if (MinRating == 0 && rating == 0) return 0;
        
        // Распределяем от 1 до maxStars звезд для ненулевых оценок
        var normalizedRating = ((rating - MinRating) / range) * maxStars;
        return Math.Max(1, (int)Math.Round(normalizedRating)); // Минимум 1 звезда для ненулевых оценок
    }

    private double ConvertFromStarRating(int starRating)
    {
        // Преобразуем из звездочной системы обратно в исходную
        var maxStars = GetMaxStars();
        
        if (starRating <= 0) return MinRating;
        if (starRating >= maxStars) return MaxRating;
        
        var range = MaxRating - MinRating;
        if (range <= 0) return MinRating; // Защита от деления на ноль
        
        // Преобразуем от 1-maxStars звезд обратно в исходный диапазон
        if (maxStars <= 1) return MaxRating; // Защита от деления на ноль
        return MinRating + ((starRating - 1) / (double)(maxStars - 1) * range);
    }

    private Color GetContentTypeColor(ContentType contentType) => contentType switch
    {
        ContentType.Video => Color.Primary,
        ContentType.Audio => Color.Secondary,
        ContentType.Image => Color.Tertiary,
        _ => Color.Default
    };

    private string GetContentTypeIcon(ContentType contentType) => contentType switch
    {
        ContentType.Video => Icons.Material.Filled.VideoLibrary,
        ContentType.Audio => Icons.Material.Filled.AudioFile,
        ContentType.Image => Icons.Material.Filled.Image,
        _ => Icons.Material.Filled.QuestionMark
    };

    public void Dispose()
    {
        // Освобождение ресурсов, если необходимо
    }
} 