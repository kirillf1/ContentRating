@page "/"


<PageTitle>ContentRating</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-16">
    <MudText Typo="Typo.h2" Align="Align.Center" GutterBottom="true">
        ContentRating
    </MudText>
    
    <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-8">
        Система оценки контента
    </MudText>

    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="3" Class="pa-4">
                <MudCardContent>
                    <div style="text-align:center">
                        <MudIcon Icon="Icons.Material.Filled.Star" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.h6" Class="mt-2">Оценки</MudText>
                        <MudText Typo="Typo.body2">Управление оценками контента</MudText>

                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
        
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="3" Class="pa-4">
                <MudCardContent>
                    <div style="text-align:center">
                        <MudIcon Icon="Icons.Material.Filled.Analytics" Color="Color.Secondary" Size="Size.Large" />
                        <MudText Typo="Typo.h6" Class="mt-2">Аналитика</MudText>
                        <MudText Typo="Typo.body2">Анализ данных и отчеты</MudText>

                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
        
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="3" Class="pa-4">
                <MudCardContent>
                    <div style="text-align:center">
                        <MudIcon Icon="Icons.Material.Filled.Settings" Color="Color.Tertiary" Size="Size.Large" />
                        <MudText Typo="Typo.h6" Class="mt-2">Настройки</MudText>
                        <MudText Typo="Typo.body2">Конфигурация системы</MudText>

                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

</MudContainer>
