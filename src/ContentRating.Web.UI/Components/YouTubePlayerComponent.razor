@using System.Text.RegularExpressions
@using MudBlazor

<div class="youtube-video-container" style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden;">
    @if (IsLoaded)
    {
        <iframe src="@GetYouTubeEmbedUrl()"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
        </iframe>
    }
    else
    {
        <!-- YouTube Thumbnail вместо placeholder -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; cursor: pointer;"
             @onclick="LoadVideo">
            
            <!-- Фоновое изображение - thumbnail YouTube -->
            <img src="@GetYouTubeThumbnailUrl()" 
                 alt="YouTube видео"
                 style="width: 100%; height: 100%; object-fit: cover; border-radius: 4px;"
                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
            
            <!-- Overlay с кнопкой воспроизведения -->
            <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.3); display: flex; align-items: center; justify-content: center; transition: background 0.3s ease;"
                 onmouseover="this.style.background='rgba(0,0,0,0.5)'" 
                 onmouseout="this.style.background='rgba(0,0,0,0.3)'">
                
                @if (ShouldAutoLoad)
                {
                    <div style="background: rgba(255,255,255,0.95); border-radius: 50px; padding: 20px; display: flex; align-items: center; flex-direction: column;">
                        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                        <div style="font-size: 0.9rem; margin-top: 8px; color: #333;">
                            Загружаем...
                        </div>
                    </div>
                }
                else
                {
                    <!-- Большая кнопка воспроизведения -->
                    <div style="background: rgba(255,255,255,0.95); border-radius: 50%; width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 20px rgba(0,0,0,0.3); transition: transform 0.2s ease;"
                         onmouseover="this.style.transform='scale(1.1)'" 
                         onmouseout="this.style.transform='scale(1)'">
                        <MudIcon Icon="@Icons.Material.Filled.PlayArrow" 
                                Style="font-size: 2.5rem; color: #ff0000; margin-left: 4px;" />
                    </div>
                }
            </div>
            
            <!-- Fallback для случая когда thumbnail не загрузился -->
            <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: none; align-items: center; justify-content: center; border-radius: 4px;">
                <div style="color: white; text-align: center;">
                    <MudIcon Icon="@Icons.Material.Filled.VideoLibrary" Style="font-size: 3rem; opacity: 0.7; margin-bottom: 8px;" />
                    <div style="font-size: 0.9rem; opacity: 0.8;">YouTube видео</div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Url { get; set; } = string.Empty;
    [Parameter] public bool AutoLoad { get; set; } = false;

    private bool IsLoaded { get; set; } = false;
    private bool ShouldAutoLoad { get; set; } = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AutoLoad && !IsLoaded)
        {
 
            IsLoaded = true;
            ShouldAutoLoad = false;
            StateHasChanged();
        }
    }

    protected override void OnParametersSet()
    {
        if (!AutoLoad)
        {
            ShouldAutoLoad = false;
        }
    }

    private void LoadVideo()
    {
        IsLoaded = true;
        StateHasChanged();
    }

    private string GetYouTubeVideoId(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return string.Empty;

        var patterns = new[]
        {
            @"(?:https?:\/\/)?(?:www\.)?youtube\.com\/watch\?v=([a-zA-Z0-9_-]+)",
            @"(?:https?:\/\/)?(?:www\.)?youtu\.be\/([a-zA-Z0-9_-]+)",
            @"(?:https?:\/\/)?(?:www\.)?youtube\.com\/embed\/([a-zA-Z0-9_-]+)",
            @"(?:https?:\/\/)?(?:www\.)?youtube\.com\/v\/([a-zA-Z0-9_-]+)"
        };

        foreach (var pattern in patterns)
        {
            var match = Regex.Match(url, pattern, RegexOptions.IgnoreCase);
            if (match.Success)
            {
                return match.Groups[1].Value;
            }
        }

        return string.Empty;
    }

    private string GetYouTubeEmbedUrl()
    {
        var videoId = GetYouTubeVideoId(Url);
        if (string.IsNullOrEmpty(videoId))
            return string.Empty;

        return $"https://www.youtube.com/embed/{videoId}?autoplay=1&rel=0&modestbranding=1&showinfo=0";
    }

    private string GetYouTubeThumbnailUrl()
    {
        var videoId = GetYouTubeVideoId(Url);
        if (string.IsNullOrEmpty(videoId))
            return string.Empty;

        // Используем hqdefault (480x360) - он доступен для всех видео
        // maxresdefault (1280x720) доступен не для всех видео
        return $"https://img.youtube.com/vi/{videoId}/hqdefault.jpg";
    }
} 