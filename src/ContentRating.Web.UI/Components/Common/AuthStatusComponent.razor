@using ContentRating.Web.UI.Services
@using ContentRating.Web.UI.Services.Authentication
@inject AuthService AuthService
@implements IDisposable

@if (showStatus)
{
    <MudAlert Severity="@GetSeverity()" Variant="Variant.Filled" Class="rounded-0">
        <div class="d-flex align-center justify-space-between">
            <div class="d-flex align-center">
                <MudIcon Icon="@GetIcon()" Class="mr-2" />
                <MudText>@GetStatusText()</MudText>
            </div>
            @if (!AuthService.IsAuthenticated)
            {
                <MudButton Variant="Variant.Text" 
                          Color="Color.Inherit" 
                          Size="Size.Small"
                          OnClick="LoginAsync">
                    Войти
                </MudButton>
            }
        </div>
    </MudAlert>
}

@code {
    private bool showStatus = true;

    protected override void OnInitialized()
    {
        AuthService.AuthStateChanged += OnAuthStateChanged;
        UpdateStatusVisibility();
    }

    private void OnAuthStateChanged()
    {
        UpdateStatusVisibility();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateStatusVisibility()
    {
        // Показываем статус если пользователь не авторизован
        showStatus = !AuthService.IsAuthenticated;
    }

    private Severity GetSeverity()
    {
        return AuthService.IsAuthenticated ? Severity.Success : Severity.Warning;
    }

    private string GetIcon()
    {
        return AuthService.IsAuthenticated ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning;
    }

    private string GetStatusText()
    {
        if (AuthService.IsAuthenticated)
        {
            return $"Добро пожаловать, {AuthService.UserName}!";
        }
        return "Для полного доступа к функциям войдите в систему";
    }

    private async Task LoginAsync()
    {
        await AuthService.LoginWithGoogle();
    }

    public void Dispose()
    {
        AuthService.AuthStateChanged -= OnAuthStateChanged;
    }
} 