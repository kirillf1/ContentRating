@using ContentRating.Domain.AggregatesModel.ContentPartyEstimationRoomAggregate
@using ContentRating.Web.Contracts.Identity
@using ContentRating.Web.UI.Services
@using ContentRating.Web.UI.Services.Authentication
@using MudBlazor
@inject IUserService UserService
@inject ISnackbar Snackbar
@inject ILogger<InviteUsersDialog> Logger

<MudDialog>
    <DialogContent>
        <MudContainer MaxWidth="MaxWidth.Medium">
            @if (_isLoading)
            {
                <MudGrid Justify="Justify.Center" Class="pa-4">
                    <MudItem>
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </MudItem>
                </MudGrid>
            }
            else
            {
                <MudTabs Elevation="2" Rounded="true" Class="mb-4">
                    <MudTabPanel Text="Пользователи системы" Icon="@Icons.Material.Filled.People">
                        <MudGrid Class="mt-2">
                            @if (_users?.Any() == true)
                            {
                                @foreach (var user in _users.Where(u => !u.Name.StartsWith("Mock:")))
                                {
                                    <MudItem xs="12">
                                        <MudCard Elevation="1" Class="pa-2">
                                            <MudGrid AlignItems="Center">
                                                <MudItem xs="8">
                                                    <MudText Typo="Typo.body1">@user.Name</MudText>
                                                </MudItem>
                                                <MudItem xs="4" Class="text-right">
                                                    <MudButton 
                                                        Variant="Variant.Filled" 
                                                        Color="Color.Primary" 
                                                        Size="Size.Small"
                                                        OnClick="() => InviteUser(user)"
                                                        Disabled="_inviting">
                                                        @if (_inviting)
                                                        {
                                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                                        }
                                                        else
                                                        {
                                                            <text>Пригласить</text>
                                                        }
                                                    </MudButton>
                                                </MudItem>
                                            </MudGrid>
                                        </MudCard>
                                    </MudItem>
                                }
                            }
                            else
                            {
                                <MudItem xs="12">
                                    <MudAlert Severity="Severity.Info">
                                        Нет доступных пользователей для приглашения
                                    </MudAlert>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="Mock пользователи" Icon="@Icons.Material.Filled.SmartToy">
                        <MudGrid Class="mt-2">
                            <MudItem xs="12">
                                <MudAlert Severity="Severity.Info" Class="mb-3">
                                    Mock пользователи - это виртуальные участники, которые работают офлайн. 
                                    Вы можете управлять их оценками самостоятельно.
                                </MudAlert>
                            </MudItem>
                            
                            <MudItem xs="12">
                                <MudTextField @bind-Value="_newMockUserName" 
                                             Label="Имя mock пользователя" 
                                             Variant="Variant.Outlined"
                                             Placeholder="Введите имя виртуального участника"
                                             Class="mb-3" />
                                <MudButton 
                                    Variant="Variant.Filled" 
                                    Color="Color.Secondary" 
                                    FullWidth="true"
                                    OnClick="CreateAndInviteMockUser"
                                    Disabled="_inviting || string.IsNullOrWhiteSpace(_newMockUserName)">
                                    @if (_inviting)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                        <MudText Class="ml-2">Создание...</MudText>
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" />
                                        <text>Создать и пригласить mock пользователя</text>
                                    }
                                </MudButton>
                            </MudItem>

                            @if (_users?.Any(u => u.Name.StartsWith("Mock:")) == true)
                            {
                                <MudItem xs="12">
                                    <MudDivider Class="my-3" />
                                    <MudText Typo="Typo.h6" Class="mb-2">Созданные mock пользователи:</MudText>
                                </MudItem>
                                
                                @foreach (var mockUser in _users.Where(u => u.Name.StartsWith("Mock:")))
                                {
                                    <MudItem xs="12">
                                        <MudCard Elevation="1" Class="pa-2">
                                            <MudGrid AlignItems="Center">
                                                <MudItem xs="2">
                                                    <MudIcon Icon="@Icons.Material.Filled.SmartToy" Color="Color.Secondary" />
                                                </MudItem>
                                                <MudItem xs="6">
                                                    <MudText Typo="Typo.body1">@mockUser.Name</MudText>
                                                </MudItem>
                                                <MudItem xs="4" Class="text-right">
                                                    <MudButton 
                                                        Variant="Variant.Filled" 
                                                        Color="Color.Secondary" 
                                                        Size="Size.Small"
                                                        OnClick="() => InviteMockUser(mockUser)"
                                                        Disabled="_inviting">
                                                        @if (_inviting)
                                                        {
                                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                                        }
                                                        else
                                                        {
                                                            <text>Пригласить</text>
                                                        }
                                                    </MudButton>
                                                </MudItem>
                                            </MudGrid>
                                        </MudCard>
                                    </MudItem>
                                }
                            }
                        </MudGrid>
                    </MudTabPanel>
                </MudTabs>
            }
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Закрыть</MudButton>
    </DialogActions>
</MudDialog>

@code {
        [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Guid RoomId { get; set; }
    [Parameter] public EventCallback OnUserInvited { get; set; }

    private IEnumerable<UserResponse>? _users;
    private bool _isLoading = true;
    private bool _inviting = false;
    private string _newMockUserName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
            _users = await UserService.GetAllUsersAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка загрузки пользователей для приглашения");
            Snackbar.Add($"Ошибка загрузки пользователей: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task InviteUser(UserResponse user)
    {
        _inviting = true;
        try
        {
            var success = await UserService.InviteUserToRoomAsync(RoomId, user.Id, user.Name, RoleType.Default);
            if (success)
            {
                Snackbar.Add($"Пользователь {user.Name} приглашен в комнату", Severity.Success);
                await OnUserInvited.InvokeAsync();
                MudDialog?.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add($"Ошибка при приглашении пользователя {user.Name}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при приглашении пользователя {UserName} в комнату {RoomId}", user.Name, RoomId);
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
        finally
        {
            _inviting = false;
            StateHasChanged();
        }
    }

    private async Task InviteMockUser(UserResponse mockUser)
    {
        _inviting = true;
        try
        {
            var success = await UserService.InviteUserToRoomAsync(RoomId, mockUser.Id, mockUser.Name, RoleType.Mock);
            if (success)
            {
                Snackbar.Add($"Mock пользователь {mockUser.Name} приглашен в комнату", Severity.Success);
                await OnUserInvited.InvokeAsync();
                MudDialog?.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add($"Ошибка при приглашении mock пользователя {mockUser.Name}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при приглашении mock пользователя {UserName} в комнату {RoomId}", mockUser.Name, RoomId);
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
        finally
        {
            _inviting = false;
            StateHasChanged();
        }
    }

    private async Task CreateAndInviteMockUser()
    {
        if (string.IsNullOrWhiteSpace(_newMockUserName))
            return;

        _inviting = true;
        try
        {
            var success = await UserService.InviteMockUserToRoomAsync(RoomId, _newMockUserName.Trim());
            if (success)
            {
                Snackbar.Add($"Mock пользователь '{_newMockUserName}' создан и приглашен в комнату", Severity.Success);
                _newMockUserName = string.Empty;
                await OnUserInvited.InvokeAsync();
                await LoadUsers(); // Обновляем список пользователей
            }
            else
            {
                Snackbar.Add($"Ошибка при создании mock пользователя", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Ошибка при создании mock пользователя {MockUserName} в комнате {RoomId}", _newMockUserName, RoomId);
            Snackbar.Add($"Ошибка: {ex.Message}", Severity.Error);
        }
        finally
        {
            _inviting = false;
            StateHasChanged();
        }
    }

    private void Cancel() => MudDialog?.Close();
} 